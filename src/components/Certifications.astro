---
import { BadgeCheck, ExternalLink, Clock } from '@lucide/astro';
import { certifications } from '../data/certifications';
---
<section id="certifications" class="section" aria-labelledby="certs-title" style="padding-top:0">
  <div class="container">
    <div class="section-head">
      <span class="kicker">// 05 · credentials registry</span>
      <h2 id="certs-title">Certifications</h2>
      <p>Industry credentials from Red Hat and AWS, each with a link to its official source.</p>
    </div>
    <div class="cert-grid">
      {certifications.map((c) => (
        <article class="panel cert">
          <div class="panel-bar">
            <span>{c.issuer}</span>
            <span class="badge green"><span class="dot green" aria-hidden="true"></span>CREDENTIAL</span>
          </div>
          <div class="cert-body">
            <span class="cert-code">{c.code}</span>
            <h3>{c.name}</h3>
            <span class="meta">SCOPE: {c.scope}</span>
            <p>{c.plain}</p>
            <div class="cert-links">
              {c.verifyUrl ? (
                <a href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
                  <BadgeCheck aria-hidden="true" /> Verify credential <ExternalLink aria-hidden="true" />
                </a>
              ) : (
                <span class="pending"><Clock aria-hidden="true" /> Verification link coming soon</span>
              )}
              <a href={c.infoUrl} target="_blank" rel="noopener noreferrer">
                About this certification <ExternalLink aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
