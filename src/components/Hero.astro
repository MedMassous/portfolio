---
import { ArrowRight, Download } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { profile } from '../data/profile';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="panel hero-panel">
      <p class="hero-operator">
        <span class="dot green pulse" aria-hidden="true"></span>
        SYSTEM OPERATOR: {profile.name.toUpperCase()}
      </p>
      <h1 id="hero-title">{profile.name}</h1>
      <p class="role">{profile.title}</p>
      <p class="tagline">“{profile.tagline}”</p>
      <div class="hero-actions">
        <a class="btn primary" href="#projects">View infrastructure projects <ArrowRight aria-hidden="true" /></a>
        <a class="btn" href={profile.cvPath} download><Download aria-hidden="true" /> Download professional CV</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer"><BrandIcon name="github" /> GitHub</a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer"><BrandIcon name="linkedin" /> LinkedIn</a>
      </div>
    </div>
  </div>
</section>
