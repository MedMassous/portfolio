---
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import { publishedProjects, statusLabels, type ProjectStatus } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return publishedProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const tone: Record<ProjectStatus, string> = {
  completed: 'green',
  'in-progress': 'amber',
  planned: 'blue',
  lab: 'slate',
};
const statusNotice: Partial<Record<ProjectStatus, string>> = {
  'in-progress': 'This project is still being built. Details may change.',
  planned: 'This project is planned and has not started yet.',
  lab: 'This is a learning lab, not a production system.',
};
---
<Base
  title={`${project.name} — ${profile.name}`}
  description={project.summary}
  path={`/projects/${project.slug}/`}
>
  <div class="container case">
    <a class="back-link" href="/#projects"><ArrowLeft size={16} aria-hidden="true" /> BACK TO REGISTRY</a>

    <header class="panel case-head">
      <span class="meta">DEPLOYMENT RECORD · {project.type}</span>
      <h1>{project.name}</h1>
      <span class={`badge ${tone[project.status]}`}>
        <span class={`dot ${tone[project.status]}`} aria-hidden="true"></span>
        {statusLabels[project.status]}
      </span>
      <p style="margin-top:16px;margin-bottom:0;max-width:62ch">{project.summary}</p>
    </header>

    {statusNotice[project.status] && <p class="notice">{statusNotice[project.status]}</p>}

    <div class="case-grid">
      <div style="display:grid;gap:20px">
        <section class="panel case-section">
          <h2>Overview</h2>
          {project.overview.map((p) => <p>{p}</p>)}
        </section>
        <section class="panel case-section">
          <h2>Goals</h2>
          <ul>{project.goals.map((g) => <li>{g}</li>)}</ul>
        </section>
      </div>

      <aside class="panel case-section">
        <h2>Record</h2>
        <dl class="kv" style="grid-template-columns:70px 1fr">
          <dt>Type</dt><dd>{project.type}</dd>
          <dt>Status</dt><dd>{statusLabels[project.status]}</dd>
          <dt>Stack</dt>
          <dd><div class="stack-list">{project.stack.map((s) => <span class="tag">{s}</span>)}</div></dd>
        </dl>
        {(project.repoUrl || project.demoUrl) && (
          <div style="display:grid;gap:10px;margin-top:20px">
            {project.repoUrl && <a class="btn" href={project.repoUrl} target="_blank" rel="noopener noreferrer">Source code <ExternalLink aria-hidden="true" /></a>}
            {project.demoUrl && <a class="btn" href={project.demoUrl} target="_blank" rel="noopener noreferrer">Live demo <ExternalLink aria-hidden="true" /></a>}
          </div>
        )}
        {project.note && <p class="meta" style="text-transform:none;letter-spacing:0.02em;margin-top:18px;margin-bottom:0">{project.note}</p>}
      </aside>
    </div>
  </div>
</Base>
